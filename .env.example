# Supabase — copy this file to .env.local and fill in your project values.
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key (NEVER expose to the browser). Used by trusted server actions
# such as creating a merchant during onboarding. Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of the deployed app (QR links, SMS hub URLs, emails).
# Prefer APP_URL. NEXT_PUBLIC_SITE_URL is also accepted for client-side QR.
# Dev: http://localhost:3000   Prod: https://froq.io
# No trailing slash. Never hardcode domains in code.
# Email CTAs skip localhost / *.vercel.app and fall back to https://froq.io
# (optional override: PUBLIC_APP_URL).
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# PUBLIC_APP_URL=https://froq.io

# Vercel Cron — required for /api/cron/* routes.
# Generate: openssl rand -hex 32
# Add the same value in Vercel Project Settings → Environment Variables as CRON_SECRET.
# Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Note: WhatsApp Meta templates register a fixed base URL button
#   https://froq.io/c/{{1}}
# Runtime only sends the dynamic suffix: url_buttons["0"] = customer.publicToken
# Sample values used for Meta approval must never be sent at runtime.

# ─────────────────────────────────────────────────────────────────────────────
# Resend — transactional email (password reset, etc.). Server-only.
# RESEND_FROM_EMAIL must be a verified domain in Resend for production.
# Until your domain is verified, Resend allows: Froq <onboarding@resend.dev>
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Froq <hello@froq.io>
# Admin quota meters assume Resend Transactional Pro: 50k/month, unlimited daily,
# billing renew day 7 (UTC). Update src/lib/admin/resend-quota.ts if the plan changes.

# ─────────────────────────────────────────────────────────────────────────────
# APITxT — OTP delivery (WhatsApp primary via Unified OTP API, SMS fallback)
# Dashboard → Settings → API. Server-only; NEVER expose to the browser.
APITXT_AUTH_KEY=your-apitxt-authkey
APITXT_PROJECT_REF_ID=PROJ_1c54b9ef2a44
APITXT_WHATSAPP_TEMPLATE_NAME=otp
# ISO dialing code for WhatsApp OTP billing (APITxT expects "91", not "IN")
# APITXT_WHATSAPP_COUNTRY=91

# Transactional SMS (customer notifications when WhatsApp is not preferred).
# Required for SMS fallback of stamp/reward/waitlist/reservation alerts.
# APITXT_SMS_SENDER=FROQTX
# APITXT_SMS_PE_ID=your-dlt-principal-entity-id
# APITXT_SMS_ROUTE=4
# APITXT_SMS_TEMPLATE_ID=optional-default-dlt-template-id
# Optional per-template DLT ids:
# APITXT_SMS_TEMPLATE_STAMP_VERIFIED=
# APITXT_SMS_TEMPLATE_REWARD_UNLOCKED=
# APITXT_SMS_TEMPLATE_STAMP_COLLECTED_LAST_WAIT_TIME=1701178608466487163
#   DLT: loyaltycard_reward_unlocked_wait_time
#   Hi {var}, you've collected all {var}/{var} stamps at {var}. Reward {var} unlocked. Redeem in {var}. Card: {var} Powered by Froq.io
#   Vars: customerName, currentStamps, totalStamps, businessName, rewardName, waitTime, loyaltyCardUrl
#   (Default ID is baked in when this env is unset.)
# APITXT_SMS_TEMPLATE_REWARD_READY_WAIT_TIME=
# APITXT_SMS_TEMPLATE_REWARD_REDEEMED=
# APITXT_SMS_TEMPLATE_WAITLIST_CALLED=
# APITXT_SMS_TEMPLATE_RESERVATION_CONFIRMED=

# Country code prefixed to 10-digit Indian numbers before sending/looking up.
OTP_COUNTRY_CODE=91

# Secret used to HMAC-hash OTPs before storing them. Use a long random string.
# Generate with: openssl rand -hex 32
OTP_HASH_SECRET=change-me-to-a-long-random-string

# ─────────────────────────────────────────────────────────────────────────────
# Razorpay Payments — Standard Checkout + Subscriptions.
# RAZORPAY_KEY_SECRET is server-only; NEVER expose it to the browser.
# NEXT_PUBLIC_RAZORPAY_KEY_ID is safe to ship to the client (Key ID only).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# Webhook signing secret (Dashboard → Webhooks → Secret). Endpoint:
#   POST /api/webhooks/razorpay
# Events: payment.captured, payment.failed, refund.*, subscription.*, invoice.*
# RAZORPAY_WEBHOOK_SECRET=rzp_whsec_xxxxxxxx

# Optional overrides for Razorpay Plan ids (Dashboard → Subscriptions → Plans).
# Defaults are baked into src/lib/payments/razorpay-plans.ts.
# Loyalty:
# RAZORPAY_PLAN_STARTER=plan_xxx
# RAZORPAY_PLAN_GROWTH=plan_xxx
# RAZORPAY_PLAN_PRO=plan_xxx
# RAZORPAY_PLAN_STARTER_YEARLY=plan_xxx
# RAZORPAY_PLAN_GROWTH_YEARLY=plan_xxx
# RAZORPAY_PLAN_PRO_YEARLY=plan_xxx
# AI Menu:
# RAZORPAY_PLAN_MENU_STARTER=plan_xxx
# RAZORPAY_PLAN_MENU_GROWTH=plan_xxx
# RAZORPAY_PLAN_MENU_PRO=plan_xxx
# RAZORPAY_PLAN_MENU_STARTER_YEARLY=plan_xxx
# RAZORPAY_PLAN_MENU_GROWTH_YEARLY=plan_xxx
# RAZORPAY_PLAN_MENU_PRO_YEARLY=plan_xxx

# ─────────────────────────────────────────────────────────────────────────────
# Google Identity Services — One Tap and the rendered "Continue with Google"
# button. Web OAuth client ID from Google Cloud → Credentials.
#   • Public by design (it ships in the page); the client secret stays in Supabase.
#   • Add every origin you serve (http://localhost:3000, https://froq.io) to the
#     client's Authorized JavaScript origins, or One Tap silently won't show.
#   • Add this same ID under Supabase → Authentication → Providers → Google →
#     Client IDs, otherwise the ID token is rejected as a wrong audience.
# Leave empty to fall back to the redirect-based Google sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Cloudflare Turnstile (bot protection on public forms + Supabase Auth captcha).
# Site key is public; keep the secret server-side only (never commit real values).
# Prefer TURNSTILE_SECRET (Spin / Cloudflare convention); TURNSTILE_SECRET_KEY still works.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# AI Menu preview — the product is still being built. "true" shows it in the
# product rail and opens its /merchant/menu routes; anything else keeps it a
# coming-soon tile and 404s the routes.
NEXT_PUBLIC_MENU_PREVIEW=false

# ─────────────────────────────────────────────────────────────────────────────
# Super Admin dashboard (/admin) — comma-separated allowlist of operator emails.
# Must match a Supabase Auth user. Empty = nobody can access /admin.
SUPER_ADMIN_EMAILS=capt.tanmay10@gmail.com

# ─────────────────────────────────────────────────────────────────────────────
# Gemini via the froq-apoi Cloudflare Worker (cloudflare-worker/index.js).
# The Google key never leaves the Worker; the app authenticates with a bearer
# token. Server-only — never expose AI_WORKER_TOKEN to the browser.
# Set the same token on the Worker:
#   npx wrangler secret put AI_PROXY_TOKEN --name froq-apoi
AI_WORKER_URL=https://froq-apoi.capt-tanmay10.workers.dev
AI_WORKER_TOKEN=your-ai-proxy-token

# Optional: direct Google Places (otherwise Places go through the Worker above).
# GOOGLE_PLACES_API_KEY=
# GOOGLE_API_KEY=

# Optional: operating cash float (INR) for Platform Costs cash runway.
PLATFORM_CASH_INR=200000
# Optional: fixed monthly infra invoices when billing APIs are unavailable.
# Supabase org plan snapshot (no public invoice API). Froq: Pro $25 + Micro $10 = $35 × FX 84 → 2940
# PLATFORM_COST_SUPABASE_INR_MONTH=2940
# PLATFORM_COST_VERCEL_INR_MONTH=
# Cloudflare: do NOT rely on /accounts/:id/billable/usage (alpha/restricted — 1171).
# Platform Costs uses GA /accounts/:id/billing/history when possible, else this monthly INR (default 0).
# PLATFORM_COST_CLOUDFLARE_INR_MONTH=0
# Optional: ApiTxt SMS prepaid rate override (default 0.15).
# APITXT_SMS_RATE_INR=0.15

# Optional: deeper Infrastructure admin panels.
# Vercel → Account Settings → Tokens (billing charges need team access)
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
# Cloudflare → My Profile → API Tokens
# Permissions: Account · Account Analytics · Read, Account · Workers Scripts · Read
# Optional account/script overrides (auto-detected from /accounts + AI_WORKER_URL).
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_WORKER_SCRIPT=froq-apoi

# ─────────────────────────────────────────────────────────────────────────────
# Marketing — Google Analytics 4 + paid ads (admin /admin/marketing)
# Measurement ID (G-…) is public. Property ID is numeric (GA4 Admin → Property settings).
# Service account needs Viewer on the GA4 property; paste JSON or base64.
GA4_MEASUREMENT_ID=G-K9HGV4MEFN
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-K9HGV4MEFN
# GA4_PROPERTY_ID=123456789
# GA4_SERVICE_ACCOUNT_JSON=
# GA4_SERVICE_ACCOUNT_JSON_BASE64=
# Meta Ads (Marketing API)
# META_ADS_ACCESS_TOKEN=
# META_ADS_AD_ACCOUNT_ID=act_xxxxxxxx
# Google Ads (Ads API + OAuth desktop/web client refresh token)
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=1234567890
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=   # MCC manager id if applying via manager account
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
